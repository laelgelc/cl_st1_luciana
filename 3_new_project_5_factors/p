import csv
from wordcloud import WordCloud
import matplotlib.pyplot as plt

reader = csv.reader(open('profiles/wordclouds/wc.csv', 'r',newline='\n'))
d = {}
for k,v in reader:
    d[k] = int(v)

#Generating wordcloud. Relative scaling value is to adjust the importance of a frequency word.
wordcloud = WordCloud(width=1600,height=800).generate_from_frequencies(d)

#wordcloud = WordCloud(width=1600,height=800, colormap="Oranges", background_color="orange").generate_from_frequencies(d)


# Open a plot of the generated image.

plt.figure( figsize=(20,10))
plt.imshow(wordcloud, interpolation='bilinear')
plt.axis("off")
